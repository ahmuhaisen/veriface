{
  "name": "@veriface/capture",
  "version": "0.1.0",
  "private": true,
  "description": "Browser capture SDK for Veriface: live guidance and auto-capture of a selfie and an ID-document photo. It never calls the face service.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./src/element.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/types/element.d.ts",
      "default": "./dist/element.js"
    },
    "./face-capture.worker.js": "./dist/face-capture.worker.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "bin": {
    "veriface-capture-assets": "./scripts/copy-assets.mjs"
  },
  "files": [
    "dist",
    "scripts/copy-assets.mjs",
    "scripts/fetch-models.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.worker.config.ts && tsc -p tsconfig.build.json && node scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:models": "node scripts/fetch-models.mjs examples/basic/public/face-capture/models",
    "example": "npm run build && node scripts/copy-assets.mjs examples/basic/public/face-capture && vite --config examples/basic/vite.config.ts",
    "soak:network": "npm run build && node scripts/soak-network.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
