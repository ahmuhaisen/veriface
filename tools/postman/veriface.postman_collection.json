{
  "info": {
    "_postman_id": "78e94440-6ffa-5c38-9bcb-d11db757441b",
    "name": "Veriface API v1",
    "description": "Local test collection for the Veriface service (contracts/openapi.yaml).\n\n1. Start the service: `service\\target-lead\\release\\veriface.exe run --config tools\\console\\.dev\\config.toml`.\n2. Import this collection and the environment `tools/console/.dev/veriface.local.postman_environment.json` (git-ignored, holds your dev API key), then select the environment.\n3. File parts point at testdata/ on this machine; replace them with your own photos in each request's Body tab.\n\nQuality/verification RESULTS (including rejections) are HTTP 200; errors are RFC 9457 problem+json. Thresholds are provisional (calibration.status = provisional). Images are processed in memory and never stored.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "profile",
      "value": "standard"
    }
  ],
