    {
      "name": "Verification (selfie vs ID)",
      "item": [
        {
          "name": "Verify - same person",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/verifications?profile=fixtures&referenceKind=auto",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "verifications"
              ],
              "query": [
                {
                  "key": "profile",
                  "value": "fixtures",
                  "disabled": false,
                  "description": "fixtures = dev-only; use standard for real photos"
                },
                {
                  "key": "referenceKind",
                  "value": "auto",
                  "disabled": false,
                  "description": "auto | document | portrait"
                },
                {
                  "key": "operatingPoint",
                  "value": "fmr-1e-4",
                  "disabled": true,
                  "description": "fmr-1e-3 | fmr-1e-4 (default)"
                }
              ]
            },
            "description": "Probe = selfie, reference = ID card photo. With testdata use profile=fixtures (expect match; outcome review because the card reuses the same photo).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "probe",
                  "type": "file",
                  "src": "testdata/images/nasa-watkins.jpg",
                  "description": "selfie"
                },
                {
                  "key": "reference",
                  "type": "file",
                  "src": "testdata/documents/doc-watkins-glare.jpg",
                  "description": "ID card photo or portrait"
