    {
      "name": "Quality (selfie)",
      "item": [
        {
          "name": "Quality - good portrait",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/quality?profile={{profile}}&output=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "quality"
              ],
              "query": [
                {
                  "key": "profile",
                  "value": "{{profile}}",
                  "disabled": false,
                  "description": "standard | icao-strict | fixtures (dev only). Omit for the key's default."
                },
                {
                  "key": "output",
                  "value": "true",
                  "disabled": false,
                  "description": "Include the normalised output image (base64 JPEG)."
                }
              ]
            },
            "description": "Assess a selfie. Replace the image with your own.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "testdata/images/nasa-watkins.jpg",
                  "description": "JPEG, PNG or WebP"
                }
              ]
            }
